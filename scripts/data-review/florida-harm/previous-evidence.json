    "conductEvidence": [
      {
        "sourceKey": "fl:statute:782.07:1",
        "target": "text",
        "text": "The killing of a human being by the act, procurement, or culpable negligence of another",
        "start": 233,
        "end": 320,
        "sourceHash": "2dc8e2be861854f9db54b928abffbeba8a4e014c5c3657b2d16b578817bb136c"
      },
      {
        "sourceKey": "fl:statute:782.07:1",
        "target": "text",
        "text": "without lawful justification according to the provisions of chapter 776",
        "start": 322,
        "end": 393,
        "sourceHash": "2dc8e2be861854f9db54b928abffbeba8a4e014c5c3657b2d16b578817bb136c"
      },
      {
        "sourceKey": "fl:statute:782.07:1",
        "target": "text",
        "text": "such killing shall not be excusable homicide or murder",
        "start": 416,
        "end": 470,
        "sourceHash": "2dc8e2be861854f9db54b928abffbeba8a4e014c5c3657b2d16b578817bb136c"
      }
    ],
    "gradeEvidence": [
      {
        "sourceKey": "fl:statute:782.07:1",
        "target": "text",
        "text": "is manslaughter, a felony of the second degree, punishable as provided in s. 775.082, s. 775.083, or s. 775.084.",
