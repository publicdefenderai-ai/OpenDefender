    ],
    "gradeEvidence": [
      {
        "sourceKey": "fl:statute:825.102:2",
        "target": "text",
        "text": "A person who commits aggravated abuse of an elderly person or disabled adult commits a felony of the first degree, punishable as provided in s. 775.082, s. 775.083, or s. 775.084.",
