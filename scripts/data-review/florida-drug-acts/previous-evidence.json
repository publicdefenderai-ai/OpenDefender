      "sourceHash": "d087a2f6005abfe8a24146886d094031a6c97758d2cb684073db085a562ed536"
    },
    "conductEvidence": [
      {
        "sourceKey": "fl:statute:893.147:5",
        "target": "text",
        "text": "It is unlawful for any person to place in any newspaper, magazine, handbill, or other publication any advertisement, knowing, or under circumstances where one reasonably should know, that the purpose of the advertisement, in whole or in part, is to promote the sale of objects designed or intended for use as drug paraphernalia.",
        "start": 3077,
        "end": 3405,
        "sourceHash": "d087a2f6005abfe8a24146886d094031a6c97758d2cb684073db085a562ed536"
      }
    ],
    "gradeEvidence": [
      {
        "sourceKey": "fl:statute:893.147:5",
        "target": "text",
        "text": "Any person who violates this subsection is guilty of a misdemeanor of the first degree, punishable as provided in s. 775.082 or s. 775.083.",
        "start": 3406,
        "end": 3545,
        "sourceHash": "d087a2f6005abfe8a24146886d094031a6c97758d2cb684073db085a562ed536",
        "category": "misdemeanor"
      }
    ],
