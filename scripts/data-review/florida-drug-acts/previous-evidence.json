      "target": "title",
      "text": "Use, possession, manufacture, delivery, transportation, advertisement, or retail sale of drug paraphernalia, specified machines, and materials",
      "start": 0,
      "end": 142,
      "sourceHash": "d087a2f6005abfe8a24146886d094031a6c97758d2cb684073db085a562ed536"
    },
    "conductEvidence": [
      {
        "sourceKey": "fl:statute:893.147:3_b",
        "target": "text",
        "text": "It is unlawful for any person to sell or otherwise deliver hypodermic syringes, needles, or other objects which may be used, are intended for use, or are designed for use in parenterally injecting substances into the human body to any person under 18 years of age, except that hypodermic syringes, needles, or other such objects may be lawfully dispensed to a person under 18 years of age by a licensed practitioner, parent, or legal guardian or by a pharmacist pursuant to a valid prescription for same.",
        "start": 1856,
        "end": 2360,
        "sourceHash": "d087a2f6005abfe8a24146886d094031a6c97758d2cb684073db085a562ed536"
      }
    ],
    "gradeEvidence": [
      {
        "sourceKey": "fl:statute:893.147:3_b",
        "target": "text",
        "text": "Any person who violates the provisions of this paragraph is guilty of a misdemeanor of the first degree, punishable as provided in s. 775.082 or s. 775.083.",
        "start": 2361,
        "end": 2517,
        "sourceHash": "d087a2f6005abfe8a24146886d094031a6c97758d2cb684073db085a562ed536",
        "category": "misdemeanor"
      }
    ],
