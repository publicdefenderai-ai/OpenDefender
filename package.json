{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:release": "node scripts/release-check/run-browser-tests.mjs",
    "test:live:guardrail": "tsx tests/e2e/mitigation-live-guardrail.ts",
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "NODE_ENV=production vite build && NODE_ENV=production esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && NODE_ENV=production esbuild scripts/data-review/seed-new-york-source-database.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/seed-new-york-source-database.js && NODE_ENV=production esbuild scripts/data-review/seed-texas-source-database.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/seed-texas-source-database.js && NODE_ENV=production esbuild scripts/data-review/seed-florida-source-database.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/seed-florida-source-database.js && NODE_ENV=production esbuild scripts/data-review/seed-pennsylvania-source-database.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/seed-pennsylvania-source-database.js && NODE_ENV=production esbuild scripts/data-review/seed-south-carolina-source-database.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/seed-south-carolina-source-database.js && NODE_ENV=production esbuild scripts/data-review/seed-illinois-source-database.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/seed-illinois-source-database.js && NODE_ENV=production esbuild scripts/data-review/seed-ohio-source-database.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/seed-ohio-source-database.js && NODE_ENV=production esbuild scripts/data-review/seed-georgia-source-database.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/seed-georgia-source-database.js",
    "start": "node scripts/start-production.mjs",
    "start:release-check": "node scripts/release-check/start-production.mjs",
    "check": "tsc",
    "audit:dependencies": "npm audit --omit=dev --audit-level=moderate",
    "release:verify": "npm run check && npm run review:source-coverage && npm run audit:dependencies && npm run review:pennsylvania-source && npm run test:authority-boundary && npm run test:e2e:release",
    "test:authority-boundary": "NODE_ENV=${NODE_ENV:-development} node scripts/release-check/run-authority-boundary-tests.mjs",
    "db:push": "drizzle-kit push",
    "db:seed:california": "tsx scripts/data-review/seed-california-source-database.ts",
    "db:seed:new-york": "tsx scripts/data-review/seed-new-york-source-database.ts",
    "db:seed:texas": "tsx scripts/data-review/seed-texas-source-database.ts",
    "db:seed:florida": "tsx scripts/data-review/seed-florida-source-database.ts",
    "db:seed:pennsylvania": "tsx scripts/data-review/seed-pennsylvania-source-database.ts",
    "review:pennsylvania-source": "tsx scripts/data-review/check-pennsylvania-source.ts",
    "db:seed:south-carolina": "tsx scripts/data-review/seed-south-carolina-source-database.ts",
    "db:seed:illinois": "tsx scripts/data-review/seed-illinois-source-database.ts",
    "review:detention": "tsx scripts/data-review/check-detention-facilities.ts",
    "review:consulates": "tsx scripts/data-review/check-consulates.ts",
    "review:legal-aid": "tsx scripts/data-review/check-legal-aid.ts",
    "review:report": "tsx scripts/data-review/generate-report.ts",
    "review:source-coverage": "tsx scripts/data-review/check-public-source-coverage.ts --write",
    "review:all": "npm run review:detention && npm run review:consulates && npm run review:legal-aid && npm run review:report",
    "review:check": "tsc --project tsconfig.scripts.json",
    "content:review": "tsx scripts/content-review/review-content.ts",
    "content:review:guidance": "tsx scripts/content-review/review-content.ts guidance",
    "content:review:immigration": "tsx scripts/content-review/review-content.ts immigration",
    "content:review:support": "tsx scripts/content-review/review-content.ts support",
    "content:review:resources": "tsx scripts/content-review/review-content.ts resources",
    "content:report": "tsx scripts/content-review/generate-report.ts",
    "content:all": "npm run content:review && npm run content:report"
  },
