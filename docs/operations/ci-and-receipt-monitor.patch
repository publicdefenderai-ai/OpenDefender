@@ -0,0 +1,29 @@
+# Install at .github/workflows/statutory-evidence-freshness.yml on main.
+name: Statutory evidence receipt deadlines
+on:
+  schedule:
+    - cron: '17 13 * * *'
+  workflow_dispatch:
+  pull_request:
+    paths:
+      - 'scripts/check-statutory-receipt-freshness.mjs'
+      - 'shared/california-freshness-core.mjs'
+      - 'shared/california-retained-pins.json'
+      - 'scripts/data-review/output/california-retained-refresh-comparison.json'
+      - 'scripts/data-review/output/*-refresh-receipt.json'
+      - '.github/workflows/statutory-evidence-freshness.yml'
+permissions:
+  contents: read
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - name: Fail for invalid, expired, or due-within-48-hours receipts
+        run: node scripts/check-statutory-receipt-freshness.mjs
